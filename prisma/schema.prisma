generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  date      DateTime
  time      String
  createdAt DateTime @default(now())
}
